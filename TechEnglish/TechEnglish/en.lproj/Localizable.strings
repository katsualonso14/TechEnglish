"invoked" = "to request help from someone, especially a god, when you want to improve a situation";
"exception" = "someone or something that is not included in a rule, group";
"occurred" = "(especially of accidents and other unexpected events) to happen";
"related" = "connected";
"existing" = "used to refer to something that exists now";
"inherited" = "received from someone who has died";
"embed" = "to fix something firmly into a substance";
"opposed" = "completely different or be opposed to something";
"fetch" = "to go to another place to get something";

"ancestor" = "a person related to you who lived a long time ago";
"modify" = "to change something such as a plan, opinion, law";
"contained" = "to have something inside or include something as a part";
"identifiable" = "able to be recognized";
"instead" = "in place of someone or something else";
"verify" = "to prove that something exists or is true";
"permission" = "if someone is given permission to do something, they are allowed to do it";
"permanent" = "lasting for a long time or forever";

"denied" = "to say that something is not true";
"constraint" = "something that controls what you do by keeping you within particular limits";
"attempted" = "(of a crime) that someone has tried to commit without success";
"indeed" = "really or certainly, often used to emphasize something";
"suspended" = "to stop something from being active, either temporarily or permanently";
"observable" = "that can be noticed or seen";
"deprecated" = "to not approve of something or say that you do not approve of something";
"absolute" = "very great or to the largest degree possible";
