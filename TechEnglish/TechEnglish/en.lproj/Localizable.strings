// MARK: - Tech Words Vocabulary
// Error & Exception
"exception_meaning" = "someone or something that is not included in a rule, group";
"occurred_meaning" = "(especially of accidents and other unexpected events) to happen";
"detected_meaning" = "discovered or noticed something";
"permission_dinied_meaning" = "not allowed to access or perform";
"deprecated_meaning" = "to disapprove of something";
"terminated_meaning" = "to bring something to an end";
"denied_meaning" = "to refuse to accept something";
"invalid_meaning" = "not acceptable or not correct";
"failed_meaning" = "not successful in achieving a goal";
"attempted_meaning" = "to try to do something";

// Documents
"outdated_meaning" = "no longer in use or relevant";
"deprecated_meaning" = "discouraged from use, often due to being outdated";
"obsolete_meaning" = "no longer produced or used";
"superseded_meaning" = "replaced by something newer or better";
"experimental_meaning" = "being tested, not fully developed";
"stable_meaning" = "fully tested and reliable for use";

// Data
"index_indices_meaning" = "A position in a list or array.";
"structure_struct_meaning" = "A type that groups related data.";
"constraint_meaning" = "A rule that limits or restricts values.";
"mutable_meaning" = "A data type that can be modified.";
"immutable_meaning" = "Cannot be changed once set.";
"queue_meaning" = "A data structure that processes items in order.";
"existing_meaning" = "Already present or available data.";

// Lifecycle
"suspended_meaning" = "temporarily paused or inactive";
"persistent_meaning" = "continuing to exist or retain data over time";
"embed_meaning" = "insert data or content within another structure";
"fetch_meaning" = "retrieve data from a source";
"unbounded_meaning" = "without a fixed limit or restriction";
"invoked_meaning" = "called or triggered for execution";
"asynchronous_meaning" = "not executed immediately; may complete later";
"inherited_meaning" = "received properties or behavior from a parent";
"ancestor_meaning" = "a parent or higher-level element in a hierarchy";
"permanent_meaning" = "lasting indefinitely or without change";

// Setting
"assume_meaning" = "to accept something as true without proof";
"specify_meaning" = "to state something in detail and clearly";
"determines_meaning" = "to decide or establish something definitively";
"intended_meaning" = "planned or meant for a specific purpose or outcome";
"prerequisites_meaning" = "requirements or conditions that must be fulfilled beforehand";
"identifiable_meaning" = "able to be recognized or distinguished from others";
"absolute_meaning" = "not subject to change; independent of other factors";
"contained_meaning" = "included or held within something else";

// Coding Test
"indices_meaning" = "positions within an array or list";
"constraint_meaning" = "rules that limit possible values or behavior";
"expression_meaning" = "a mathematical or logical statement";
"decreasing_order_meaning" = "arranged from largest to smallest";
"non_decreasing_order_meaning" = "arranged without decreasing (can stay the same or increase)";
"calculation_meaning" = "the process of computing or solving numerically";
"palindrome_number_meaning" = "a number that reads the same backward and forward";
"depth_meaning" = "level of nesting or recursion in data or logic";
"absolute_meaning" = "a value regardless of sign (e.g., |-3| = 3)";
"prerequisites_meaning" = "requirements or conditions that must be met first";
"proportionally_meaning" = "in the right ratio";
"opposed_meaning" = "against something";

// Other
"related_meaning" = "connected";
"invoked_meaning" = "to request help from someone, when you want to improve a situation";
"modify_meaning" = "to change something such as a plan, opinion, law";
"verify_meaning" = "to prove that something exists or is true";
"indeed_meaning" = "really or certainly, often used to emphasize something";
"instead_meaning" = "in place of someone or something else";
"shorthand_notation_meaning" = "a shortened form of writing something";

